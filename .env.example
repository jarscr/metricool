# Metricool (userToken desde Account Settings > API)
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_API_BASE_URL=https://app.metricool.com/api
METRICOOL_TIMEZONE=America/Costa_Rica

# Administrador inicial del dashboard. En el primer acceso se crea en
# dashboard_users con password_hash; luego las empresas se administran en la web.
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=metricool_dashboard
DB_USER=root
DB_PASS=

# Sync
SYNC_LOG_DIR=logs/sync
# console/sync.php sincroniza automáticamente ayer y hoy.
# Para recuperar historia usa --start y --end en la línea de comandos.
